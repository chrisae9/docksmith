{
  "name": "docksmith-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for Docksmith",
  "scripts": {
    "test": "docker compose run --rm playwright npx playwright test",
    "test:local": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
