    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
